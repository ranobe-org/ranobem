<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- the cover fills the cell width and keeps the 2:3 shape of a manga cover -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/novel_cover_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/novel_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?colorSurfaceContainerHighest"
            android:contentDescription="@string/manga_cover"
            android:scaleType="centerCrop" />

        <!-- unread chapters, library only; read out as part of the cover's description -->
        <TextView
            android:id="@+id/unread_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="?colorPrimary"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="24dp"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:textAppearance="?textAppearanceLabelMedium"
            android:textColor="?colorOnPrimary"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="12"
            tools:visibility="visible" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/source_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textAppearance="?textAppearanceLabelSmall"
        android:textColor="?colorPrimary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/novel_cover_layout"
        tools:text="WeebCentral"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/novel_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="?textAppearanceBodySmall"
        android:textColor="?colorOnSurface"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/source_name"
        tools:text="The Seventh Prince Wants to Bail" />

</androidx.constraintlayout.widget.ConstraintLayout>
