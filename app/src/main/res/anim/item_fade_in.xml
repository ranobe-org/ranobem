<?xml version="1.0" encoding="utf-8"?>
<!-- a short, quiet fade with a slight rise, used when a list first shows its items -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="220"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha
        android:fromAlpha="0"
        android:toAlpha="1" />
    <translate
        android:fromYDelta="6%"
        android:toYDelta="0" />
</set>
